{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pictayo",
  "compatibility_date": "2026-07-31",
  "main": "./feedback-worker.js",
  "observability": { "enabled": true },
  "vars": {
    "GITHUB_REPO": "christopher-013/Pictayo",
    // Both the custom domain and the github.io origin are listed. GitHub keeps
    // serving the old one as a redirect, and feedback and usage counting are
    // rejected outright from any origin not named here.
    "ALLOWED_ORIGINS": "https://pictayo.com,https://www.pictayo.com,https://christopher-013.github.io,https://pictayo.cch13.workers.dev,http://127.0.0.1:5276,http://127.0.0.1:5273,http://localhost:5276,http://localhost:5273"
  },
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "51012",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Anonymous usage counts: one integer per UTC day, no per-visitor records.
  // Replace the id with the one printed by:
  //   npx wrangler kv namespace create USAGE_COUNTS
  "kv_namespaces": [
    {
      "binding": "USAGE_COUNTS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  // 08:00 UTC daily digest of the previous day's counts.
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  // The built site ships with the Worker, so one deploy serves both the pages
  // and the API. `wrangler deploy` runs the build first, which means the
  // uploaded assets are always the ones the type check and smoke suite passed.
  "build": {
    "command": "npm run build"
  },
  // Only the two API paths reach the Worker; everything else is served straight
  // from the built site. Without listing them here an `/api/...` request would
  // be answered by the asset handler as a missing file.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/feedback", "/api/ping"]
  }
}
