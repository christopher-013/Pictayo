{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "picturepicture-feedback",
  "compatibility_date": "2026-07-31",
  "main": "./feedback-worker.js",
  "observability": { "enabled": true },
  "vars": {
    "GITHUB_REPO": "christopher-013/Pictayo",
    "ALLOWED_ORIGINS": "https://christopher-013.github.io,https://picturepicture-feedback.cch13.workers.dev,http://127.0.0.1:5276,http://127.0.0.1:5273,http://localhost:5276,http://localhost:5273"
  },
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "51012",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Anonymous usage counts: one integer per UTC day, no per-visitor records.
  // Replace the id with the one printed by:
  //   npx wrangler kv namespace create USAGE_COUNTS
  "kv_namespaces": [
    {
      "binding": "USAGE_COUNTS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  // 08:00 UTC daily digest of the previous day's counts.
  "triggers": {
    "crons": ["0 8 * * *"]
  }
}
