{
  "name": "picturepicture",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Import your photos and let their metadata organize them — grouped by date, plotted on a map.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/make-fixtures.mjs",
    "brand": "node scripts/make-brand.mjs",
    "smoke": "node --import ./scripts/ts-resolve-register.mjs scripts/smoke.mjs",
    "verify": "npm run fixtures && npm run build && npm run smoke",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.5"
  }
}
